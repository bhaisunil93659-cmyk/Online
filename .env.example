# Copy to .env and set your own values. Never commit .env.
PORT=3000
NODE_ENV=development
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-long-private-password"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
